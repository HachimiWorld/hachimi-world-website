{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hachimi-world-website",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Song pages (server-side rendering) and sitemaps (proxied from storage) run the worker;
    // everything else is served as static files.
    "run_worker_first": ["/song/*", "/sitemap/*"]
  },
  // Required by `wrangler preview`, which Workers Builds runs for non-production branches.
  "previews": {},
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
