{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hachimi-world-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
