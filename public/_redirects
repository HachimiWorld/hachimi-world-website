# Web app moved to its own subdomain; old links land on the app root.
/app      https://app.hachimi.world/  301
/app/*    https://app.hachimi.world/  301

# Song share links: /song/<id> renders the song page, which reads the id from the path.
# The target is extensionless because Workers' html_handling redirects *.html to the pretty URL.
/song     /song/  301
/song/*   /song/song  200
